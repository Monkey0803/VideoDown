# Copy to `keystore.properties` and fill in your own release key.
# `keystore.properties` is git-ignored; never commit a real signing key.
#
# Generate a key with:
#   keytool -genkeypair -v -keystore keystore/release.keystore -storetype PKCS12 \
#     -alias <your-alias> -keyalg RSA -keysize 2048 -validity 10000

storeFile=keystore/release.keystore
storePassword=change-me
keyAlias=change-me
keyPassword=change-me
